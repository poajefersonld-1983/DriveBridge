[Unit]
Description=DriveBridge - pagina interna de sincronizacao Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@CONFIG_DIR@/web.env
ExecStart=@PROJECT_DIR@/.venv/bin/drivebridge-web
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
